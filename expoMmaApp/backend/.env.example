# Backend-only environment. Copy to `.env` in this folder (`expoMmaApp/backend/`).
# Do NOT put these values in `expoMmaApp/.env` or any EXPO_PUBLIC_* variable.
# The Expo app never talks to Gemini or OpenAI directly.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=180
GEMINI_VIDEO_FPS=8
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_SECONDS=2
QUICK_SIMILARITY_SAMPLES=60
QUICK_SIMILARITY_WARP_FRACTION=0.08

# Experimental/legacy Phase 7 still-image path (not used by production Detailed Analysis).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=120

# Copy to `.env` in this folder (expoMmaApp/) and replace with your PC's LAN IPv4.
# Do not use localhost — on a physical phone that is the phone itself.
#
# Windows: `ipconfig` → look for "Wireless LAN adapter Wi-Fi" (or Ethernet)
#          IPv4 Address, e.g. 192.168.1.42
#
# Then restart Expo (`npm run dev` or `npx expo start`) so the public env var is picked up.
# The value MUST include the scheme, e.g. http://192.168.1.42:8000 — not 192.168.1.42:8000.

EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:8000

# Do NOT put OPENAI_API_KEY or GEMINI_API_KEY here. Detailed AI Analysis uses backend/.env only.

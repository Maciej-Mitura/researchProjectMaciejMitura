{
  "name": "mma-trainer-v2",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:logic": "tsx --test logic-tests/privacy.test.ts logic-tests/speech.test.ts logic-tests/validation.test.ts logic-tests/catalog.test.ts logic-tests/errors.test.ts",
    "dev:app": "expo start",
    "dev:backend": "cd backend && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "dev": "concurrently --kill-others-on-fail --names app,backend --prefix-colors cyan,magenta \"npm run dev:app\" \"npm run dev:backend\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.14",
    "expo-file-system": "~57.0.5",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-video": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  }
}
